# Supabase — used by the browser bundle (inlined at build time)
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# Supabase — used by SSR / server functions (read at runtime)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_PROJECT_ID="<project-ref>"

# Optional. Only needed if server code starts using supabaseAdmin (bypasses RLS).
# Never expose this to the client and never commit it.
# SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
